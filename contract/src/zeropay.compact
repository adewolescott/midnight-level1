pragma language_version >= 0.20;

import CompactStandardLibrary;

export ledger vaultTotal: Uint<64>;
export ledger payoutRoot: Bytes<32>;
export ledger nullifierSet: Map<Bytes<32>, Boolean>;

// Witness declarations for private off-chain employee data
witness getSecretKey(): Bytes<32>;
witness getProof(): Vector<4, Bytes<32>>;
witness getIndices(): Vector<4, Boolean>;

// Circuit: Employer deposits batch funds and commits the Merkle root
export circuit depositPayroll(
  depositAmount: Uint<64>,
  newPayoutRoot: Bytes<32>
): [] {
  assert(depositAmount > 0, "ZeroPay: Deposit amount must be greater than zero");
  vaultTotal = (vaultTotal + disclose(depositAmount)) as Uint<64>;
  payoutRoot = disclose(newPayoutRoot);
}

// Circuit: Employee claims confidential payout using private witness
export circuit claimPayout(
  publicNullifier: Bytes<32>,
  payoutAmount: Uint<64>
): [] {
  // 1. Vault solvency check
  assert(vaultTotal >= payoutAmount, "ZeroPay: Insufficient vault funds");

  // 2. Anti double-claim check (disclose public nullifier checking ledger)
  assert(!nullifierSet.member(disclose(publicNullifier)), "ZeroPay: Payout has already been claimed");

  // 3. Obtain private witness data off-chain
  const secret = getSecretKey();

  // 4. Verify nullifier derivation: H(secret, payoutRoot)
  const computedNullifier = persistentHash<Vector<2, Bytes<32>>>([secret, payoutRoot]);
  assert(computedNullifier == publicNullifier, "ZeroPay: Invalid witness proof for nullifier");

  // 5. Update public ledger state
  nullifierSet.insert(disclose(publicNullifier), true);
  vaultTotal = (vaultTotal - disclose(payoutAmount)) as Uint<64>;
}
